# Yellen light — Powerlevel10k prompt theme
# Source: source "$HOME/Yellen/powerlevel10k/yellen-light.zsh"
# in ~/.p10k.zsh, or add to ~/.zshrc after p10k is loaded.
# Hex #RRGGBB values are supported by Powerlevel10k.

typeset -g POWERLEVEL9K_BACKGROUND=
typeset -g POWERLEVEL9K_FOREGROUND="#332A0D"

# Context (user@hostname)
typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND="#332A0D"
typeset -g POWERLEVEL9K_CONTEXT_BACKGROUND="#F1E8C4"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND="#A4442D"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_BACKGROUND="#F1E8C4"

# Directory
typeset -g POWERLEVEL9K_DIR_FOREGROUND="#332A0D"
typeset -g POWERLEVEL9K_DIR_BACKGROUND="#FBF6DE"
typeset -g POWERLEVEL9K_DIR_HOME_FOREGROUND="#332A0D"
typeset -g POWERLEVEL9K_DIR_HOME_BACKGROUND="#FBF6DE"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND="#332A0D"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_BACKGROUND="#FBF6DE"
typeset -g POWERLEVEL9K_DIR_ETC_FOREGROUND="#806010"
typeset -g POWERLEVEL9K_DIR_ETC_BACKGROUND="#FBF6DE"

# VCS (git)
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND="#82630C"
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND="#FBF6DE"
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND="#7E620E"
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND="#FBF6DE"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND="#806010"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND="#FBF6DE"
typeset -g POWERLEVEL9K_VCS_LOADING_FOREGROUND="#75673C"
typeset -g POWERLEVEL9K_VCS_LOADING_BACKGROUND="#FBF6DE"

# Status (exit code)
typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND="#82630C"
typeset -g POWERLEVEL9K_STATUS_OK_BACKGROUND="#FBF6DE"
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND="#A4442D"
typeset -g POWERLEVEL9K_STATUS_ERROR_BACKGROUND="#FBF6DE"

# Prompt char
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#82630C"
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#A4442D"
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=

# Time
typeset -g POWERLEVEL9K_TIME_FOREGROUND="#75673C"
typeset -g POWERLEVEL9K_TIME_BACKGROUND="#FBF6DE"

# Command execution time
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND="#806010"
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_BACKGROUND="#FBF6DE"

# Background jobs
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND="#98613A"
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_BACKGROUND="#FBF6DE"

# Root indicator
typeset -g POWERLEVEL9K_ROOT_INDICATOR_FOREGROUND="#A4442D"
typeset -g POWERLEVEL9K_ROOT_INDICATOR_BACKGROUND="#FBF6DE"

# Dir writable
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_FOREGROUND="#A4442D"
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_BACKGROUND="#FBF6DE"

# Separators
typeset -g POWERLEVEL9K_LEFT_SEGMENT_SEPARATOR='\uE0B0'
typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR='\uE0B2'
typeset -g POWERLEVEL9K_LEFT_SUBSEGMENT_SEPARATOR='\uE0B1'
typeset -g POWERLEVEL9K_RIGHT_SUBSEGMENT_SEPARATOR='\uE0B3'
