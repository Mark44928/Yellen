# Yellen dark — Powerlevel10k prompt theme
# Source: source "$HOME/Yellen/powerlevel10k/yellen-dark.zsh"
# in ~/.p10k.zsh, or add to ~/.zshrc after p10k is loaded.
# Hex #RRGGBB values are supported by Powerlevel10k.

typeset -g POWERLEVEL9K_BACKGROUND=
typeset -g POWERLEVEL9K_FOREGROUND="#F3E8B8"

# Context (user@hostname)
typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND="#F3E8B8"
typeset -g POWERLEVEL9K_CONTEXT_BACKGROUND="#24200C"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND="#C76A52"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_BACKGROUND="#24200C"

# Directory
typeset -g POWERLEVEL9K_DIR_FOREGROUND="#F3E8B8"
typeset -g POWERLEVEL9K_DIR_BACKGROUND="#171408"
typeset -g POWERLEVEL9K_DIR_HOME_FOREGROUND="#F3E8B8"
typeset -g POWERLEVEL9K_DIR_HOME_BACKGROUND="#171408"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND="#F3E8B8"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_BACKGROUND="#171408"
typeset -g POWERLEVEL9K_DIR_ETC_FOREGROUND="#D8A93B"
typeset -g POWERLEVEL9K_DIR_ETC_BACKGROUND="#171408"

# VCS (git)
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND="#F2D14E"
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND="#171408"
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND="#F7DE72"
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND="#171408"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND="#D8A93B"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND="#171408"
typeset -g POWERLEVEL9K_VCS_LOADING_FOREGROUND="#87763B"
typeset -g POWERLEVEL9K_VCS_LOADING_BACKGROUND="#171408"

# Status (exit code)
typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND="#F2D14E"
typeset -g POWERLEVEL9K_STATUS_OK_BACKGROUND="#171408"
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND="#C76A52"
typeset -g POWERLEVEL9K_STATUS_ERROR_BACKGROUND="#171408"

# Prompt char
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#F2D14E"
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#C76A52"
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=

# Time
typeset -g POWERLEVEL9K_TIME_FOREGROUND="#87763B"
typeset -g POWERLEVEL9K_TIME_BACKGROUND="#171408"

# Command execution time
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND="#D8A93B"
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_BACKGROUND="#171408"

# Background jobs
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND="#C98B6B"
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_BACKGROUND="#171408"

# Root indicator
typeset -g POWERLEVEL9K_ROOT_INDICATOR_FOREGROUND="#C76A52"
typeset -g POWERLEVEL9K_ROOT_INDICATOR_BACKGROUND="#171408"

# Dir writable
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_FOREGROUND="#C76A52"
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_BACKGROUND="#171408"

# Separators
typeset -g POWERLEVEL9K_LEFT_SEGMENT_SEPARATOR='\uE0B0'
typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR='\uE0B2'
typeset -g POWERLEVEL9K_LEFT_SUBSEGMENT_SEPARATOR='\uE0B1'
typeset -g POWERLEVEL9K_RIGHT_SUBSEGMENT_SEPARATOR='\uE0B3'
