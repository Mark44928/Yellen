# Yellen light — micro color scheme
# Install: cp micro/yellen-light.micro ~/.config/micro/colorschemes/
# Then in micro: set colorscheme yellen-light

color-link default "#332A0D,#FBF6DE"
color-link comment "#75673C"
color-link identifier "#82630C"
color-link constant "#806010"
color-link constant.string "#7E620E"
color-link statement "bold #7A5C0A"
color-link symbol "#332A0D"
color-link symbol.operator "#7E620E"
color-link preproc "#98613A"
color-link type "#7A5C0A"
color-link special "#806010"
color-link underlined "#98613A"
color-link error "bold #A4442D"
color-link todo "bold #98613A"
color-link selection "#332A0D,#EFE4B9"
color-link statusline "#332A0D,#F1E8C4"
color-link statusline.inactive "#75673C,#FBF6DE"
color-link statusline.suggestions "#332A0D,#F1E8C4"
color-link tabbar "#332A0D,#F1E8C4"
color-link tabbar.active "#FBF6DE,#82630C"
color-link indent-char "#75673C"
color-link line-number "#75673C"
color-link current-line-number "#82630C"
color-link gutter-info "#7A5C0A"
color-link gutter-error "#A4442D"
color-link gutter-warning "#7E620E"
color-link diff-added "#82630C"
color-link diff-modified "#7E620E"
color-link diff-deleted "#A4442D"
color-link cursor-line "#F1E8C4"
color-link color-column "#F1E8C4"
color-link message "#806010"
color-link error-message "#A4442D"
color-link match-brace "#82630C"
color-link hlsearch "#7E620E,#F1E8C4"
color-link tab-error "#A4442D"
color-link trailingws "#A4442D"
color-link ignore "default"
color-link type.extended "default"
