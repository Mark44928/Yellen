# Yellen dark — micro color scheme
# Install: cp micro/yellen-dark.micro ~/.config/micro/colorschemes/
# Then in micro: set colorscheme yellen-dark

color-link default "#F3E8B8,#171408"
color-link comment "#87763B"
color-link identifier "#F2D14E"
color-link constant "#D8A93B"
color-link constant.string "#F7DE72"
color-link statement "bold #E6C15A"
color-link symbol "#F3E8B8"
color-link symbol.operator "#F7DE72"
color-link preproc "#C98B6B"
color-link type "#E6C15A"
color-link special "#D8A93B"
color-link underlined "#C98B6B"
color-link error "bold #C76A52"
color-link todo "bold #C98B6B"
color-link selection "#F7EDC4,#3A3114"
color-link statusline "#F3E8B8,#24200C"
color-link statusline.inactive "#87763B,#171408"
color-link statusline.suggestions "#F3E8B8,#24200C"
color-link tabbar "#F3E8B8,#24200C"
color-link tabbar.active "#171408,#F2D14E"
color-link indent-char "#87763B"
color-link line-number "#87763B"
color-link current-line-number "#F2D14E"
color-link gutter-info "#E6C15A"
color-link gutter-error "#C76A52"
color-link gutter-warning "#F7DE72"
color-link diff-added "#F2D14E"
color-link diff-modified "#F7DE72"
color-link diff-deleted "#C76A52"
color-link cursor-line "#24200C"
color-link color-column "#24200C"
color-link message "#D8A93B"
color-link error-message "#C76A52"
color-link match-brace "#F2D14E"
color-link hlsearch "#F7DE72,#24200C"
color-link tab-error "#C76A52"
color-link trailingws "#C76A52"
color-link ignore "default"
color-link type.extended "default"
