# Yellen light — git-delta color theme
# Include: [include] path = "$HOME/Yellen/delta/yellen-light.config"
# in ~/.gitconfig, then activate:
#   [delta] features = yellen-light
#
# Styles use git config color syntax: [attributes] foreground [background]
# or just "#RRGGBB" for foreground only. See git-config(1) color section.

[delta]
    dark = false
    light = true
    navigate = true
    line-numbers = true
    syntax-theme = Yellen light

[delta]
    commit-style = "#98613A bold"
    file-style = "#75673C bold"
    file-decoration-style = "#75673C" overline
    file-added-label = "[+]"
    file-modified-label = "[~]"
    file-removed-label = "[-]"
    file-renamed-label = "[→]"
    hunk-header-style = "#806010 bold italic"
    minus-style = "#A4442D"
    minus-emph-style = "#A4442D" bold
    plus-style = "#82630C"
    plus-emph-style = "#82630C" bold
    zero-style = "#75673C"
    whitespace-error-style = "#A4442D" reverse
    syntax-theme = Yellen light
