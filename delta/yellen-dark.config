# Yellen dark — git-delta color theme
# Include: [include] path = "$HOME/Yellen/delta/yellen-dark.config"
# in ~/.gitconfig, then activate:
#   [delta] features = yellen-dark
#
# Styles use git config color syntax: [attributes] foreground [background]
# or just "#RRGGBB" for foreground only. See git-config(1) color section.

[delta]
    dark = true
    light = false
    navigate = true
    line-numbers = true
    syntax-theme = Yellen dark

[delta]
    commit-style = "#C98B6B bold"
    file-style = "#87763B bold"
    file-decoration-style = "#87763B" overline
    file-added-label = "[+]"
    file-modified-label = "[~]"
    file-removed-label = "[-]"
    file-renamed-label = "[→]"
    hunk-header-style = "#D8A93B bold italic"
    minus-style = "#C76A52"
    minus-emph-style = "#C76A52" bold
    plus-style = "#F2D14E"
    plus-emph-style = "#F2D14E" bold
    zero-style = "#87763B"
    whitespace-error-style = "#C76A52" reverse
    syntax-theme = Yellen dark
