# Yellen dark — btop theme
# Install: cp btop/yellen-dark.theme ~/.config/btop/themes/
# and set color_theme = "yellen-dark" in btop.conf

theme[main_bg]="#171408"
theme[main_fg]="#F3E8B8"
theme[title]="#F3E8B8"
theme[hi_fg]="#F2D14E"
