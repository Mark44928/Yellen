theme[selected_fg]="#171408"
theme[inactive_fg]="#87763B"
theme[graph_text]="#F3E8B8"
theme[meter_bg]="#24200C"
theme[proc_misc]="#D8A93B"
theme[cpu_box]="#87763B"
theme[mem_box]="#E6C15A"
theme[net_box]="#F2D14E"
theme[proc_box]="#E6C15A"
theme[div_line]="#24200C"
