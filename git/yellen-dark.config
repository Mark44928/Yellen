# Yellen dark — git color configuration
# Include: [include] path = "$HOME/Yellen/git/yellen-dark.config"
# in ~/.gitconfig, or append these sections directly.
# Hex #RRGGBB values supported by git ≥ 2.26.

[color]
    ui = always
    diff = always
    status = always
    branch = always
    grep = always
    decorate = always
    interactive = always
    pager = true

[color "diff"]
    meta = "#D8A93B bold"
    frag = "#C98B6B bold"
    func = "#E6C15A"
    context = "#87763B"
    old = "#C76A52 bold"
    new = "#F2D14E bold"
    commit = "#F7DE72"
    whitespace = "#C76A52 reverse"

[color "status"]
    header = "#F3E8B8 bold"
    added = "#F2D14E"
    changed = "#F7DE72"
    untracked = "#C98B6B"
    branch = "#D8A93B bold"
    nobranch = "#C76A52 reverse"

[color "branch"]
    current = "#F2D14E bold"
    local = "#F3E8B8"
    remote = "#D8A93B"
    upstream = "#C98B6B"
    plain = "#F3E8B8"

[color "decorate"]
    branch = "#E6C15A"
    remoteBranch = "#D8A93B"
    tag = "#C98B6B"
    stash = "#F7DE72"
    HEAD = "#87763B"

[color "grep"]
    filename = "#C98B6B"
    linenumber = "#D8A93B"
    match = "#F2D14E bold"
    matchContext = "#F3E8B8"
    separator = "#87763B"

[color "interactive"]
    prompt = "#F2D14E bold"
    header = "#F3E8B8"
    help = "#87763B"
    error = "#C76A52"
