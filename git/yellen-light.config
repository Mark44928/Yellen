# Yellen light — git color configuration
# Include: [include] path = "$HOME/Yellen/git/yellen-light.config"
# in ~/.gitconfig, or append these sections directly.
# Hex #RRGGBB values supported by git ≥ 2.26.

[color]
    ui = always
    diff = always
    status = always
    branch = always
    grep = always
    decorate = always
    interactive = always
    pager = true

[color "diff"]
    meta = "#806010 bold"
    frag = "#98613A bold"
    func = "#7A5C0A"
    context = "#75673C"
    old = "#A4442D bold"
    new = "#82630C bold"
    commit = "#7E620E"
    whitespace = "#A4442D reverse"

[color "status"]
    header = "#332A0D bold"
    added = "#82630C"
    changed = "#7E620E"
    untracked = "#98613A"
    branch = "#806010 bold"
    nobranch = "#A4442D reverse"

[color "branch"]
    current = "#82630C bold"
    local = "#332A0D"
    remote = "#806010"
    upstream = "#98613A"
    plain = "#332A0D"

[color "decorate"]
    branch = "#7A5C0A"
    remoteBranch = "#806010"
    tag = "#98613A"
    stash = "#7E620E"
    HEAD = "#75673C"

[color "grep"]
    filename = "#98613A"
    linenumber = "#806010"
    match = "#82630C bold"
    matchContext = "#332A0D"
    separator = "#75673C"

[color "interactive"]
    prompt = "#82630C bold"
    header = "#332A0D"
    help = "#75673C"
    error = "#A4442D"
